# --- Obavezno za produkciju ---
# Supabase projekat (može Olgicin postojeći). Settings > API.
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Service role ključ: koristi se SAMO na serveru (API rute). Nikad ga ne stavljaj u NEXT_PUBLIC_ promenljivu.
SUPABASE_SERVICE_ROLE_KEY=

# Javna adresa stranice (za Open Graph / canonical)
NEXT_PUBLIC_SITE_URL=https://protokol.bozinovicolgica.rs

# Lozinka za stranicu sa rezultatima: /ab-rezultati?key=OVO
AB_RESULTS_KEY=

# --- Opciono ---
# Video u hero delu (direktan .mp4 link, npr. Cloudinary). Ako je prazno, video blok se ne prikazuje.
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_VIDEO_POSTER=

# Meta Pixel i GA4: dobijaju i parametar ab_variant (a/b) uz PageView i Lead.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# n8n / Make webhook: svaka nova prijava se šalje i ovde (npr. obaveštenje Olgici na WhatsApp/Telegram).
LEAD_WEBHOOK_URL=
